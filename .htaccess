# De CRM is verhuisd naar flii.app.
Redirect 301 /projecten/crm https://flii.app/crm
Redirect 301 /crm https://flii.app/crm

# Korte link naar de case Week tegen Eenzaamheid.
Redirect 301 /case/de-buurt/week-tegen-eenzaamheid https://flii.nl/cases/de-buurt/week-tegen-eenzaamheid

Options -MultiViews
RewriteEngine On

# Redirect /index.html to /
RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Opgeheven kennisbanktermen wijzen naar het overzicht.
RewriteRule ^kennisbank/(ab-testen|agile-marketing|ai-governance|api-s|apps|artificial-intelligence|attribution|audio-podcasts|b2b-marketing|brand-architecture|brand-identity|brand-positioning|business-intelligence|campagnes|cdp|cms|community-management|concurrentieanalyse|content-operations|contentkalender|contentmarketing|conversieoptimalisatie-cro|cookiebanners|copywriting|corporate-communicatie|cpa|creative-direction|crm-systemen|customer-experience-cx|customer-journey|customer-success|dashboard|data-science|duurzaamheid-esg|earned-media|evenementen|experimentation-a-b-testing|fotografie|go-to-market|google-analytics|grafisch-ontwerp|growth-marketing|illustratie|influencer-marketing|interne-communicatie|klantonderzoek|kpi-management|landingspagina|lead-generation|leveranciersmanagement|loyalty|marketing-analytics|marketing-automation|marketing-ethics|marketing-management|marketing-stack|marketplace-marketing|marktanalyse|marktonderzoek|martech|merkstrategie|motion-design|owned-media|packaging|paid-media|performance-max|persona|personal-branding|predictive-analytics|pricing|processen|programmatic|programmatic-advertising|public-relations|reclamewetgeving|reputatiemanagement|retail-marketing|sales-enablement|sea|social-media|social-media-marketing|sponsoring|storytelling|targeting|trade-marketing|traditionele-media|ui-design|ux-design|video|video-advertising|visual-design|waardepropositie|web-analytics|websites)/?$ /kennisbank [R=301,L]

# Dienstenstructuur: vier categorieën. Oude pagina's wijzen naar hun opvolger of naar het overzicht.
RewriteRule ^diensten/(funnel-marketing|media-beheer|digital-advertising)(\.html)?/?$ /diensten/campagnes-media [R=301,L]
RewriteRule ^diensten/content-creatie(\.html)?/?$ /diensten/content-social [R=301,L]
RewriteRule ^diensten/(web-development|research-development)(\.html)?/?$ /diensten/web-apps-ai [R=301,L]
RewriteRule ^diensten/(data-analyse|media-management)(\.html)?/?$ /diensten/data-analyse-research [R=301,L]
RewriteRule ^diensten/development/(frontend|backend)(\.html)?/?$ /diensten/custom-code/$1 [R=301,L]
RewriteRule ^diensten/development/no-code(\.html)?/?$ /diensten/no-code [R=301,L]
RewriteRule ^diensten/development/custom-code(\.html)?/?$ /diensten/custom-code [R=301,L]
RewriteRule ^diensten/development(/.*|\.html)?$ /diensten/web-apps-ai [R=301,L]
RewriteRule ^diensten/(attributie|analyse-optimalisatie)/dashboards(\.html)?/?$ /diensten/dashboards [R=301,L]
RewriteRule ^diensten/dashboards/looker(\.html)?/?$ /diensten/dashboards/looker-studio [R=301,L]
RewriteRule ^diensten/(media|platform|content-fm|fotografie|editorial)(/.*|\.html)?$ /diensten [R=301,L]

# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# If request has no extension and .html version exists, serve it
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
