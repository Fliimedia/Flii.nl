# Toegang tot de CRM.
# Zonder het toegangscookie geeft de server 403 en wordt er niets uitgeleverd,
# ook de javascript niet. Het cookie zet je eenmalig door deze url te openen:
#
#   https://flii.nl/crm/open-AuijFN1Rl6U12EijekdyVuyQ
#
# Daarna blijft de toegang 30 dagen geldig op dit apparaat.

Options -Indexes

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /crm/

  # Openen: zet het cookie en stuur door naar de crm.
  RewriteRule ^open-AuijFN1Rl6U12EijekdyVuyQ/?$ /crm/ [CO=flii_crm=AuijFN1Rl6U12EijekdyVuyQ:flii.nl:43200:/crm:secure:httponly,R=302,L]

  # Alles zonder geldig cookie wordt geweigerd.
  RewriteCond %{HTTP_COOKIE} !flii_crm=AuijFN1Rl6U12EijekdyVuyQ
  RewriteRule ^ - [F]
</IfModule>

# Sterkere variant met wachtwoordvenster. Zet in hPanel het mapwachtwoord
# op deze map, of vul hieronder het absolute pad naar .htpasswd in:
#
# AuthType Basic
# AuthName "Flii CRM"
# AuthUserFile /home/UXXXXXXXX/domains/flii.nl/public_html/crm/.htpasswd
# Require valid-user
